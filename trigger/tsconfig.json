{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../src/lib/types.ts",
    "../src/lib/normalize.ts",
    "../src/lib/matching.ts",
    "../src/lib/evidence.ts"
  ]
}
