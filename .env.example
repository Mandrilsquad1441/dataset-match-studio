# Browser-only local matching and fixture tests need no variables or API keys.
# Copy this file to .env.local only when you opt into one of the integrations below.

# Optional: local OpenRouter model comparisons. Calls are blocked unless both
# your own key is present and ALLOW_PAID_MODEL_CALLS is exactly "true".
OPENROUTER_API_KEY=
ALLOW_PAID_MODEL_CALLS=false
JEV_MODEL=typesafe/jev-1.13
ASTRA_MODEL=openai/gpt-6-astra
EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional: browser auth and the hosted workspace API.
# Keep this false for local-only work; set true only when you intend to connect
# to your own Supabase project and API.
VITE_ENABLE_HOSTED_SERVICES=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8787
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
INTERNAL_JOB_SECRET=

# Optional: durable jobs. Trigger.dev usage may be billable under your plan.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
TRIGGER_TASK_ID=process-vendor-import
TRIGGER_API_URL=https://api.trigger.dev
MODEL_ADAPTER_MODE=test
API_BASE_URL=http://127.0.0.1:8787

# Create your own storage bucket if you enable the hosted Worker workflow.
R2_UPLOADS_BUCKET=dataset-match-files
